{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentEvent API",
    "description": "REST API for FluentEvent, the WordPress events plugin by WPManageNinja.",
    "version": "1.0.5"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-event/v2",
      "description": "Your WordPress site",
      "variables": {
        "website": {
          "default": "yourwebsite.com",
          "description": "Your WordPress site domain, without https://"
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "http",
        "scheme": "basic",
        "description": "A WordPress username and an Application Password."
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-WP-Nonce",
        "description": "Logged-in cookie plus a `wp_rest` nonce. The browser sends the cookie."
      }
    }
  },
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/events/{eventId}/guests": {
      "post": {
        "operationId": "createGuest",
        "summary": "Create Guest",
        "description": "Adds a guest to an event by hand (`source = manual`).\n\nController: `GuestController@createGuest`\nRoute source: `fluent-event/app/Http/Routes/api.php:61`",
        "tags": [
          "Guests"
        ],
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "description": "Event ID (`fe_event_details.id`).",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "guest": {
                      "type": "object",
                      "properties": {
                        "event_id": {
                          "type": "integer"
                        },
                        "calendar_id": {
                          "type": "integer"
                        },
                        "name": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string"
                        },
                        "user_id": {
                          "type": "integer"
                        },
                        "status": {
                          "type": "string"
                        },
                        "checked_in_at": {
                          "nullable": true
                        },
                        "group_id": {
                          "type": "string"
                        },
                        "is_buyer": {
                          "type": "integer"
                        },
                        "source": {
                          "type": "string"
                        },
                        "updated_at": {
                          "type": "string"
                        },
                        "created_at": {
                          "type": "string"
                        },
                        "id": {
                          "type": "integer"
                        },
                        "avatar": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "message": "Guest has been successfully saved",
                  "guest": {
                    "event_id": 3507,
                    "calendar_id": 3434,
                    "name": "Maya Chen",
                    "email": "maya.chen@example.com",
                    "user_id": 12052,
                    "status": "going",
                    "checked_in_at": null,
                    "group_id": "uxvWWJeAzvQzq2ps8LFH68E2Dt3eo7ew",
                    "is_buyer": 1,
                    "source": "manual",
                    "updated_at": "2026-11-17 17:41:46",
                    "created_at": "2026-11-17 17:41:46",
                    "id": 1370,
                    "avatar": "https://secure.gravatar.com/avatar/0512aa23cb9d989426d803e88ccc40972235fe9b60d9a03b1516f926c850050a?s=96&d=mm&r=g"
                  }
                }
              }
            }
          },
          "403": {
            "description": "The current user does not have the `manage_options` capability, or the nonce is missing.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No record with that ID.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation failed. `errors` holds one object per failing field.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "send_email": {
                    "type": "boolean",
                    "description": "Queue the confirmation email when the status is `going`."
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 255,
                    "description": "Guest name."
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 191,
                    "description": "Guest email. Unique per event in `fe_guests.email`."
                  },
                  "status": {
                    "nullable": true,
                    "type": "string",
                    "enum": [
                      "going",
                      "not_going",
                      "checked_in",
                      "cancelled"
                    ],
                    "description": "Guest status. Default `going`."
                  },
                  "user_id": {
                    "type": "integer",
                    "nullable": true,
                    "description": "Link the guest to a WordPress user. Must exist in `users.ID`. Unique per event in `fe_guests.user_id`."
                  }
                },
                "required": [
                  "name",
                  "email"
                ]
              },
              "example": {
                "name": "Maya Chen",
                "email": "maya.chen@example.com",
                "user_id": 12052,
                "status": "going",
                "send_email": true
              }
            }
          }
        }
      }
    }
  }
}
