{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentEvent API",
    "description": "REST API for FluentEvent, the WordPress events plugin by WPManageNinja.",
    "version": "1.1.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-event/v2",
      "description": "Your WordPress site",
      "variables": {
        "website": {
          "default": "yourwebsite.com",
          "description": "Your WordPress site domain, without https://"
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "http",
        "scheme": "basic",
        "description": "A WordPress username and an Application Password."
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-WP-Nonce",
        "description": "Logged-in cookie plus a `wp_rest` nonce. The browser sends the cookie."
      }
    }
  },
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/events/{eventId}/guests": {
      "get": {
        "operationId": "listGuests",
        "summary": "List Guests",
        "description": "Returns the guests of one event, paginated, with a count per status for the tabs.\n\nController: `GuestController@getGuests`\nRoute source: `fluent-event/app/Http/Routes/api.php:60`",
        "tags": [
          "Guests"
        ],
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "description": "Event ID (`fe_event_details.id`).",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Matches guest name or email.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Only guests with this status.",
            "schema": {
              "type": "string",
              "enum": [
                "going",
                "not_going",
                "checked_in",
                "cancelled"
              ]
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "description": "Items per page.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "example": 10
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number, starting at 1.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "order_by",
            "in": "query",
            "required": false,
            "description": "Column to sort by.",
            "schema": {
              "enum": [
                "id",
                "name",
                "email",
                "status",
                "created_at"
              ],
              "default": "id",
              "type": "string"
            },
            "example": "name"
          },
          {
            "name": "order_type",
            "in": "query",
            "required": false,
            "description": "Sort direction.",
            "schema": {
              "enum": [
                "ASC",
                "DESC"
              ],
              "default": "DESC",
              "type": "string"
            },
            "example": "ASC"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "guests": {
                      "type": "object",
                      "properties": {
                        "current_page": {
                          "type": "integer"
                        },
                        "data": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer"
                              },
                              "event_id": {
                                "type": "integer"
                              },
                              "name": {
                                "type": "string"
                              },
                              "email": {
                                "type": "string"
                              },
                              "user_id": {
                                "nullable": true
                              },
                              "status": {
                                "type": "string"
                              },
                              "source": {
                                "type": "string"
                              },
                              "checked_in_at": {
                                "nullable": true
                              },
                              "created_at": {
                                "type": "string"
                              },
                              "updated_at": {
                                "type": "string"
                              },
                              "avatar": {
                                "type": "string"
                              }
                            }
                          }
                        },
                        "first_page_url": {
                          "type": "string"
                        },
                        "from": {
                          "type": "integer"
                        },
                        "last_page": {
                          "type": "integer"
                        },
                        "last_page_url": {
                          "type": "string"
                        },
                        "links": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "url": {
                                "nullable": true
                              },
                              "label": {
                                "type": "string"
                              },
                              "active": {
                                "type": "boolean"
                              }
                            }
                          }
                        },
                        "next_page_url": {
                          "nullable": true
                        },
                        "path": {
                          "type": "string"
                        },
                        "per_page": {
                          "type": "integer"
                        },
                        "prev_page_url": {
                          "nullable": true
                        },
                        "to": {
                          "type": "integer"
                        },
                        "total": {
                          "type": "integer"
                        }
                      }
                    },
                    "counts": {
                      "type": "object",
                      "properties": {
                        "all": {
                          "type": "integer"
                        },
                        "going": {
                          "type": "integer"
                        },
                        "not_going": {
                          "type": "integer"
                        },
                        "checked_in": {
                          "type": "integer"
                        },
                        "cancelled": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "guests": {
                    "current_page": 1,
                    "data": [
                      {
                        "id": 1379,
                        "event_id": 3522,
                        "name": "Amara Okafor",
                        "email": "amara.okafor@example.com",
                        "user_id": null,
                        "status": "going",
                        "source": "manual",
                        "checked_in_at": null,
                        "created_at": "2026-11-18 19:58:54",
                        "updated_at": "2026-11-18 19:58:54",
                        "avatar": "https://secure.gravatar.com/avatar/29a805dddae9c60ee6d941a75546ed33eab13c9f38effbfdb0ba37a81fd3c9c2?s=96&d=mm&r=g"
                      },
                      {
                        "id": 1378,
                        "event_id": 3522,
                        "name": "Jonas Weber",
                        "email": "jonas.weber@example.com",
                        "user_id": null,
                        "status": "not_going",
                        "source": "manual",
                        "checked_in_at": null,
                        "created_at": "2026-11-18 19:58:54",
                        "updated_at": "2026-11-18 19:58:54",
                        "avatar": "https://secure.gravatar.com/avatar/0874a506e975e942d1f2555f3a6693e46e3da4c9ee73c704f43ffd493a6bc25a?s=96&d=mm&r=g"
                      },
                      {
                        "id": 1377,
                        "event_id": 3522,
                        "name": "Maya Chen",
                        "email": "maya.chen@example.com",
                        "user_id": 14823,
                        "status": "checked_in",
                        "source": "manual",
                        "checked_in_at": "2026-11-18 19:58:55",
                        "created_at": "2026-11-18 19:58:54",
                        "updated_at": "2026-11-18 19:58:55",
                        "avatar": "https://secure.gravatar.com/avatar/0512aa23cb9d989426d803e88ccc40972235fe9b60d9a03b1516f926c850050a?s=96&d=mm&r=g"
                      }
                    ],
                    "first_page_url": "https://yourwebsite.com/?page=1",
                    "from": 1,
                    "last_page": 1,
                    "last_page_url": "https://yourwebsite.com/?page=1",
                    "links": [
                      {
                        "url": null,
                        "label": "pagination.previous",
                        "active": false
                      },
                      {
                        "url": "https://yourwebsite.com/?page=1",
                        "label": "1",
                        "active": true
                      },
                      {
                        "url": null,
                        "label": "pagination.next",
                        "active": false
                      }
                    ],
                    "next_page_url": null,
                    "path": "https://yourwebsite.com",
                    "per_page": 10,
                    "prev_page_url": null,
                    "to": 3,
                    "total": 3
                  },
                  "counts": {
                    "all": 3,
                    "going": 1,
                    "not_going": 1,
                    "checked_in": 1,
                    "cancelled": 0
                  }
                }
              }
            }
          },
          "403": {
            "description": "The current user does not have the `manage_options` capability, or the nonce is missing.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No record with that ID.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
