{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentEvent API",
    "description": "REST API for FluentEvent, the WordPress events plugin by WPManageNinja.",
    "version": "1.0.2"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-event/v2",
      "description": "Your WordPress site",
      "variables": {
        "website": {
          "default": "yourwebsite.com",
          "description": "Your WordPress site domain, without https://"
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "http",
        "scheme": "basic",
        "description": "A WordPress username and an Application Password."
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-WP-Nonce",
        "description": "Logged-in cookie plus a `wp_rest` nonce. The browser sends the cookie."
      }
    }
  },
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/events/{eventId}/guests/{guestId}": {
      "patch": {
        "operationId": "updateGuest",
        "summary": "Update Guest",
        "description": "Changes a guest. Fields you leave out keep their values.\n\nController: `GuestController@updateGuest`\nRoute source: `fluent-event/app/Http/Routes/api.php:63`",
        "tags": [
          "Guests"
        ],
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "description": "Event ID (`fe_event_details.id`).",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "guestId",
            "in": "path",
            "required": true,
            "description": "Guest ID (`fe_guests.id`).",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "guest": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer"
                        },
                        "event_id": {
                          "type": "integer"
                        },
                        "calendar_id": {
                          "type": "integer"
                        },
                        "ticket_type_id": {
                          "nullable": true
                        },
                        "group_id": {
                          "type": "string"
                        },
                        "is_buyer": {
                          "type": "integer"
                        },
                        "name": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string"
                        },
                        "user_id": {
                          "type": "integer"
                        },
                        "status": {
                          "type": "string"
                        },
                        "hash": {
                          "nullable": true
                        },
                        "checked_in_at": {
                          "type": "string"
                        },
                        "payment_status": {
                          "nullable": true
                        },
                        "payment_ref": {
                          "nullable": true
                        },
                        "price": {
                          "nullable": true
                        },
                        "paid_at": {
                          "nullable": true
                        },
                        "source": {
                          "type": "string"
                        },
                        "source_id": {
                          "nullable": true
                        },
                        "meta": {
                          "nullable": true
                        },
                        "created_at": {
                          "type": "string"
                        },
                        "updated_at": {
                          "type": "string"
                        },
                        "avatar": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "message": "Guest has been successfully updated",
                  "guest": {
                    "id": 182,
                    "event_id": 665,
                    "calendar_id": 743,
                    "ticket_type_id": null,
                    "group_id": "Txiyyojoeni4kFWk0Ebxknydueh7DDTu",
                    "is_buyer": 1,
                    "name": "Maya Chen",
                    "email": "maya.chen@example.com",
                    "user_id": 9397,
                    "status": "checked_in",
                    "hash": null,
                    "checked_in_at": "2026-11-16 11:50:01",
                    "payment_status": null,
                    "payment_ref": null,
                    "price": null,
                    "paid_at": null,
                    "source": "manual",
                    "source_id": null,
                    "meta": null,
                    "created_at": "2026-11-16 11:50:01",
                    "updated_at": "2026-11-16 11:50:01",
                    "avatar": "https://secure.gravatar.com/avatar/0512aa23cb9d989426d803e88ccc40972235fe9b60d9a03b1516f926c850050a?s=96&d=mm&r=g"
                  }
                }
              }
            }
          },
          "403": {
            "description": "The current user does not have the `manage_options` capability, or the nonce is missing.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation failed. `errors` holds one object per failing field.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "send_email": {
                    "type": "boolean",
                    "description": "Send the confirmation or cancellation email that matches the status change."
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 255,
                    "description": "Guest name."
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 191,
                    "description": "Guest email. Must stay unique on the event. Unique per event in `fe_guests.email`."
                  },
                  "status": {
                    "nullable": true,
                    "type": "string",
                    "enum": [
                      "going",
                      "not_going",
                      "checked_in",
                      "cancelled"
                    ],
                    "description": "Guest status."
                  },
                  "user_id": {
                    "type": "integer",
                    "nullable": true,
                    "description": "WordPress user ID, or `null` to unlink. Must exist in `users.ID`. Unique per event in `fe_guests.user_id`."
                  }
                }
              },
              "example": {
                "status": "checked_in"
              }
            }
          }
        }
      }
    }
  }
}
