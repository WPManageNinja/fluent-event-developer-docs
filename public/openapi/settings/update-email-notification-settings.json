{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentEvent API",
    "description": "REST API for FluentEvent, the WordPress events plugin by WPManageNinja.",
    "version": "1.1.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-event/v2",
      "description": "Your WordPress site",
      "variables": {
        "website": {
          "default": "yourwebsite.com",
          "description": "Your WordPress site domain, without https://"
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "http",
        "scheme": "basic",
        "description": "A WordPress username and an Application Password."
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-WP-Nonce",
        "description": "Logged-in cookie plus a `wp_rest` nonce. The browser sends the cookie."
      }
    }
  },
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/settings/email-notifications": {
      "post": {
        "operationId": "updateEmailNotificationSettings",
        "summary": "Update Email Notification Settings",
        "description": "Turns the confirmation, cancellation and reminder emails on or off, and sets up to five reminder times.\n\nController: `SettingsController@updateEmailNotifications`\nRoute source: `fluent-event/app/Http/Routes/api.php:32`",
        "tags": [
          "Settings"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "settings": {
                      "type": "object",
                      "properties": {
                        "registration_confirmation": {
                          "type": "object",
                          "properties": {
                            "enabled": {
                              "type": "boolean"
                            }
                          }
                        },
                        "registration_cancellation": {
                          "type": "object",
                          "properties": {
                            "enabled": {
                              "type": "boolean"
                            }
                          }
                        },
                        "reminder_to_guest": {
                          "type": "object",
                          "properties": {
                            "enabled": {
                              "type": "boolean"
                            },
                            "times": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "value": {
                                    "type": "integer"
                                  },
                                  "unit": {
                                    "type": "string"
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "message": "Settings have been saved.",
                  "settings": {
                    "registration_confirmation": {
                      "enabled": true
                    },
                    "registration_cancellation": {
                      "enabled": true
                    },
                    "reminder_to_guest": {
                      "enabled": true,
                      "times": [
                        {
                          "value": 1,
                          "unit": "days"
                        },
                        {
                          "value": 2,
                          "unit": "hours"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "The current user does not have the `manage_options` capability, or the nonce is missing.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation failed. `errors` holds one object per failing field.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "registration_confirmation": {
                    "nullable": true,
                    "type": "array",
                    "items": {},
                    "description": "`{ \"enabled\": true }`"
                  },
                  "registration_cancellation": {
                    "nullable": true,
                    "type": "array",
                    "items": {},
                    "description": "`{ \"enabled\": true }`"
                  },
                  "reminder_to_guest": {
                    "type": "array",
                    "items": {
                      "properties": {
                        "enabled": {
                          "type": "boolean",
                          "description": "Turn the reminder emails on or off."
                        },
                        "times": {
                          "type": "array",
                          "maxItems": 5,
                          "items": {
                            "type": "object",
                            "properties": {
                              "unit": {
                                "type": "string",
                                "enum": [
                                  "minutes",
                                  "hours",
                                  "days"
                                ],
                                "description": "The unit."
                              },
                              "value": {
                                "type": "integer",
                                "minimum": 1,
                                "description": "How many units before the start."
                              }
                            },
                            "required": [
                              "unit",
                              "value"
                            ]
                          },
                          "description": "Up to five reminder times."
                        }
                      },
                      "required": [
                        "enabled",
                        "times"
                      ]
                    },
                    "description": "`{ \"enabled\": true, \"times\": [{ \"value\": 24, \"unit\": \"hours\" }] }`"
                  }
                },
                "required": [
                  "reminder_to_guest"
                ]
              },
              "example": {
                "registration_confirmation": {
                  "enabled": true
                },
                "registration_cancellation": {
                  "enabled": true
                },
                "reminder_to_guest": {
                  "enabled": true,
                  "times": [
                    {
                      "value": 1,
                      "unit": "days"
                    },
                    {
                      "value": 2,
                      "unit": "hours"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
