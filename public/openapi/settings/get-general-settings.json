{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentEvent API",
    "description": "REST API for FluentEvent, the WordPress events plugin by WPManageNinja.",
    "version": "1.1.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-event/v2",
      "description": "Your WordPress site",
      "variables": {
        "website": {
          "default": "yourwebsite.com",
          "description": "Your WordPress site domain, without https://"
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "http",
        "scheme": "basic",
        "description": "A WordPress username and an Application Password."
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-WP-Nonce",
        "description": "Logged-in cookie plus a `wp_rest` nonce. The browser sends the cookie."
      }
    }
  },
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/settings/general": {
      "get": {
        "operationId": "getGeneralSettings",
        "summary": "Get General Settings",
        "description": "Returns the general settings and the page chosen as the All Events page.\n\nController: `SettingsController@getGeneral`\nRoute source: `fluent-event/app/Http/Routes/api.php:23`",
        "tags": [
          "Settings"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "settings": {
                      "type": "object",
                      "properties": {
                        "default_events_view": {
                          "type": "string"
                        },
                        "disable_event_view_switch": {
                          "type": "string"
                        },
                        "events_page_id": {
                          "type": "integer"
                        },
                        "event_slug": {
                          "type": "string"
                        }
                      }
                    },
                    "pages": {
                      "type": "object",
                      "properties": {
                        "events_page_id": {
                          "nullable": true
                        }
                      }
                    }
                  }
                },
                "example": {
                  "settings": {
                    "default_events_view": "timeline",
                    "disable_event_view_switch": "no",
                    "events_page_id": 0,
                    "event_slug": "event"
                  },
                  "pages": {
                    "events_page_id": null
                  }
                }
              }
            }
          },
          "403": {
            "description": "The current user does not have the `manage_options` capability, or the nonce is missing.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
