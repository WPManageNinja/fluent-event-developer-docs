{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentEvent API",
    "description": "REST API for FluentEvent, the WordPress events plugin by WPManageNinja.",
    "version": "1.0.2"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-event/v2",
      "description": "Your WordPress site",
      "variables": {
        "website": {
          "default": "yourwebsite.com",
          "description": "Your WordPress site domain, without https://"
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "http",
        "scheme": "basic",
        "description": "A WordPress username and an Application Password."
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-WP-Nonce",
        "description": "Logged-in cookie plus a `wp_rest` nonce. The browser sends the cookie."
      }
    }
  },
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/settings/email-notifications/preview/{type}": {
      "get": {
        "operationId": "previewEmail",
        "summary": "Preview Email",
        "description": "Renders a guest email with sample data, so the settings screen can show it.\n\nController: `SettingsController@previewEmail`\nRoute source: `fluent-event/app/Http/Routes/api.php:34`",
        "tags": [
          "Settings"
        ],
        "parameters": [
          {
            "name": "type",
            "in": "path",
            "required": true,
            "description": "Which email to render.",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "subject": {
                      "type": "string"
                    },
                    "html": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "subject": "You are registered for Community Meetup",
                  "html": "<!doctype html>\n<html>\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n</head>\n<body style=\"margin: 0; padding: 0; background-color: #f0f3f5;\">\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color: #f0f3f5;\">\n        <tr>\n            <td align=\"center\" style=\"padding: 24px 16px;\">\n                <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width: 600px; width: 100%; background-color: #ffffff; border: 1px solid #d3d8de; border-radius: 8px;\">\n                    <tr>\n                        <td style=\"padding: 32px; font-family: Arial, Helvetica, sans-serif; font-size: 15px; line-height: 1.6; color: #19283a;\">\n                            <p>Hi Jane Doe,</p><p>You are registered for <strong>Community Meetup</strong> on November 23, 2026 10:00 (Asia/Dhaka).</p><p>Join online: <a href=\"https://example.com/meeting\">https://example.com/meeting</a></p><p>See you there!</p>                        </td>\n                    </tr>\n                                    </table>\n            </td>\n        </tr>\n    </table>\n</body>\n</html>\n"
                }
              }
            }
          },
          "403": {
            "description": "The current user does not have the `manage_options` capability, or the nonce is missing.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation failed. `errors` holds one object per failing field.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
