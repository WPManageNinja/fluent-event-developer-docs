{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentEvent API",
    "description": "REST API for FluentEvent, the WordPress events plugin by WPManageNinja.",
    "version": "1.0.2"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-event/v2",
      "description": "Your WordPress site",
      "variables": {
        "website": {
          "default": "yourwebsite.com",
          "description": "Your WordPress site domain, without https://"
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "http",
        "scheme": "basic",
        "description": "A WordPress username and an Application Password."
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-WP-Nonce",
        "description": "Logged-in cookie plus a `wp_rest` nonce. The browser sends the cookie."
      }
    }
  },
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/community/events/{id}/register-guest": {
      "post": {
        "operationId": "registerVisitorCommunity",
        "summary": "Register Visitor (Portal)",
        "description": "Registers a logged-out visitor for an `open` event in the FluentCommunity portal, by name and email.\n\nController: `CommunityEventController@registerGuest`\nRoute source: `fluent-event/app/Http/Routes/api.php:74`",
        "tags": [
          "Community Portal"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Record ID.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "online_meeting_url": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "You are registered.",
                  "status": "going",
                  "online_meeting_url": "https://example.com/meet/design-workshop"
                }
              }
            }
          },
          "403": {
            "description": "The nonce is missing or expired. Reload the page.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "The event is not visible.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation failed. `errors` holds one object per failing field.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "More than 5 requests in one minute from this account or IP.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nonce": {
                    "type": "string",
                    "description": "The form nonce printed on the page."
                  },
                  "website": {
                    "type": "string",
                    "description": "Honeypot field. Leave it empty: a request with a value is accepted silently and nothing is saved."
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 255
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 191,
                    "description": "Unique per event in `fe_guests.email`."
                  }
                },
                "required": [
                  "nonce",
                  "name",
                  "email"
                ]
              },
              "example": {
                "name": "Lena Fischer",
                "email": "lena.fischer@example.com",
                "nonce": "a1b2c3d4e5"
              }
            }
          }
        }
      }
    }
  }
}
