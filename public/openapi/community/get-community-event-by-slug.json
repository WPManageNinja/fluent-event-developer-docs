{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentEvent API",
    "description": "REST API for FluentEvent, the WordPress events plugin by WPManageNinja.",
    "version": "1.1.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-event/v2",
      "description": "Your WordPress site",
      "variables": {
        "website": {
          "default": "yourwebsite.com",
          "description": "Your WordPress site domain, without https://"
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "http",
        "scheme": "basic",
        "description": "A WordPress username and an Application Password."
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-WP-Nonce",
        "description": "Logged-in cookie plus a `wp_rest` nonce. The browser sends the cookie."
      }
    }
  },
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/community/events/by-slug": {
      "get": {
        "operationId": "getCommunityEventBySlug",
        "summary": "Get Community Event by Slug",
        "description": "Resolves a portal event URL (space slug + event slug) to the community post slug that shows it.\n\nController: `CommunityEventController@getEventBySlug`\nRoute source: `fluent-event/app/Http/Routes/api.php:70`",
        "tags": [
          "Community Portal"
        ],
        "parameters": [
          {
            "name": "slug",
            "in": "query",
            "required": true,
            "description": "The event post slug.",
            "schema": {
              "type": "string"
            },
            "example": "community-qa"
          },
          {
            "name": "space",
            "in": "query",
            "required": false,
            "description": "The space slug in the URL. Empty for a community-wide event.",
            "schema": {
              "default": "",
              "type": "string"
            },
            "example": ""
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "feed_slug": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "feed_slug": "join-us-community-q-a"
                }
              }
            }
          },
          "404": {
            "description": "The event does not exist, is not visible to the caller, or `space` does not match.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "cookieAuth": []
          }
        ]
      }
    }
  }
}
