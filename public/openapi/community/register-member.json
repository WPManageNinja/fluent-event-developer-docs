{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentEvent API",
    "description": "REST API for FluentEvent, the WordPress events plugin by WPManageNinja.",
    "version": "1.1.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-event/v2",
      "description": "Your WordPress site",
      "variables": {
        "website": {
          "default": "yourwebsite.com",
          "description": "Your WordPress site domain, without https://"
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "http",
        "scheme": "basic",
        "description": "A WordPress username and an Application Password."
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-WP-Nonce",
        "description": "Logged-in cookie plus a `wp_rest` nonce. The browser sends the cookie."
      }
    }
  },
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/community/events/{id}/register": {
      "post": {
        "operationId": "registerMember",
        "summary": "Register Member",
        "description": "Records a logged-in member's RSVP or registration for an event.\n\nController: `CommunityEventController@register`\nRoute source: `fluent-event/app/Http/Routes/api.php:71`",
        "tags": [
          "Community Portal"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Record ID.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "online_meeting_url": {
                      "type": "string"
                    },
                    "guest_count": {
                      "type": "integer"
                    },
                    "spots_left": {
                      "nullable": true
                    },
                    "is_full": {
                      "type": "boolean"
                    }
                  }
                },
                "example": {
                  "message": "RSVP updated. You're going!",
                  "status": "going",
                  "online_meeting_url": "https://example.com/meet/community-qa",
                  "guest_count": 1,
                  "spots_left": null,
                  "is_full": false
                }
              }
            }
          },
          "404": {
            "description": "The event is not visible to the caller.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "The registration changed under this request. Try again.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation failed. `errors` holds one object per failing field.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "More than 10 requests in one minute from this account or IP.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "going",
                      "not_going"
                    ],
                    "description": "The answer."
                  },
                  "name": {
                    "nullable": true,
                    "type": "string",
                    "maxLength": 255,
                    "description": "Open events only: the name to register under."
                  }
                },
                "required": [
                  "status"
                ]
              },
              "example": {
                "status": "going"
              }
            }
          }
        }
      }
    }
  }
}
