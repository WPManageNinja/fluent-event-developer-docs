{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentEvent API",
    "description": "REST API for FluentEvent, the WordPress events plugin by WPManageNinja.",
    "version": "1.0.5"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-event/v2",
      "description": "Your WordPress site",
      "variables": {
        "website": {
          "default": "yourwebsite.com",
          "description": "Your WordPress site domain, without https://"
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "http",
        "scheme": "basic",
        "description": "A WordPress username and an Application Password."
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-WP-Nonce",
        "description": "Logged-in cookie plus a `wp_rest` nonce. The browser sends the cookie."
      }
    }
  },
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/portal/events/{id}/register-guest": {
      "post": {
        "operationId": "registerVisitor",
        "summary": "Register Visitor (Event Page)",
        "description": "Registers anyone, logged in or not, for an `rsvp` or `open` event from its public page, by name and email.\n\nController: `PortalEventController@registerGuest`\nRoute source: `fluent-event/app/Http/Routes/api.php:77`",
        "tags": [
          "Public Event Page"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Record ID.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "html": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "You are registered.",
                  "status": "going",
                  "html": "<aside\n    class=\"fe-event-page__card fe-event-page__side\"\n    aria-label=\"Registration\"\n    data-fe-card\n    data-error=\"Something went wrong. Please try again.\"\n            data-event-nonce=\"a1b2c3d4e5\"\n            >\n    <div class=\"fe-event-page__when\">\n        <span class=\"fe-date-chip\" aria-hidden=\"true\">\n            <span class=\"fe-date-chip__month\">Dec</span>\n            <span class=\"fe-date-chip__day\">8</span>\n        </span>\n\n        <div class=\"fe-event-page__when-text\">\n            <span class=\"fe-event-page__when-date\">December 8, 2026</span>\n            <span>17:30 – 20:30 (America/New_York)</span>\n                            <span class=\"fe-event-page__when-local\">Dec 9, 04:30 – 07:30 (Asia/Dhaka)</span>\n                    </div>\n    </div>\n\n            <span class=\"fe-event-page__status fe-event-page__status--upcoming\">Starts in 3 weeks</span>\n    \n            <div class=\"fe-event-page__rsvp\">\n                            <span class=\"fe-event-page__badge\" tabindex=\"-1\" data-fe-focus>\n                    <span class=\"fe-event-page__badge-icon\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"10\" height=\"10\" viewBox=\"0 0 16 16\" fill=\"none\" aria-hidden=\"true\"><path d=\"M3.5 8.5l3 3 6-7\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n                    Going                </span>\n            \n                            <span class=\"fe-event-page__count\">3 going</span>\n                    </div>\n\n              … (truncated)"
                }
              }
            }
          },
          "403": {
            "description": "The nonce is missing or expired. Reload the page.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "The event is not on a public page.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation failed. `errors` holds one object per failing field.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "More than 5 requests in one minute from this account or IP.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "website": {
                    "type": "string",
                    "description": "Honeypot field. Leave it empty: a request with a value is accepted silently and nothing is saved."
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 255
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 191,
                    "description": "Unique per event in `fe_guests.email`."
                  },
                  "nonce": {
                    "type": "string",
                    "description": "The form nonce printed on the page."
                  }
                },
                "required": [
                  "name",
                  "email",
                  "nonce"
                ]
              },
              "example": {
                "name": "Diego Alvarez",
                "email": "diego.alvarez@example.com",
                "nonce": "a1b2c3d4e5"
              }
            }
          }
        }
      }
    }
  }
}
