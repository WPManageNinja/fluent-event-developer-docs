{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentEvent API",
    "description": "REST API for FluentEvent, the WordPress events plugin by WPManageNinja.",
    "version": "1.0.2"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-event/v2",
      "description": "Your WordPress site",
      "variables": {
        "website": {
          "default": "yourwebsite.com",
          "description": "Your WordPress site domain, without https://"
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "http",
        "scheme": "basic",
        "description": "A WordPress username and an Application Password."
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-WP-Nonce",
        "description": "Logged-in cookie plus a `wp_rest` nonce. The browser sends the cookie."
      }
    }
  },
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/events": {
      "get": {
        "operationId": "listEvents",
        "summary": "List Events",
        "description": "Returns events with their post title, calendar and guest count, filtered and paginated, for the admin events list and calendar grid.\n\nController: `EventController@getAllEvents`\nRoute source: `fluent-event/app/Http/Routes/api.php:53`",
        "tags": [
          "Events"
        ],
        "parameters": [
          {
            "name": "start_date",
            "in": "query",
            "required": false,
            "description": "Start of a date range, `Y-m-d`, in the site's time zone. Matches events that end on or after this day.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "end_date",
            "in": "query",
            "required": false,
            "description": "End of a date range, `Y-m-d`, in the site's time zone. Matches events that start on or before this day.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Matches the event title.",
            "schema": {
              "type": "string"
            },
            "example": "meetup"
          },
          {
            "name": "calendar_id",
            "in": "query",
            "required": false,
            "description": "Only events in this calendar.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Only events with this status.",
            "schema": {
              "type": "string",
              "enum": [
                "public",
                "unlisted",
                "private",
                "draft"
              ]
            }
          },
          {
            "name": "period",
            "in": "query",
            "required": false,
            "description": "`upcoming`: not ended yet, soonest first. `past`: ended, latest first. Anything else: upcoming first, then by distance from now.",
            "schema": {
              "type": "string",
              "enum": [
                "upcoming",
                "past",
                "all"
              ]
            },
            "example": "upcoming"
          },
          {
            "name": "paginate",
            "in": "query",
            "required": false,
            "description": "Set to `false` with a date window of at most 62 days to get every event in the window without paging.",
            "schema": {
              "type": "boolean",
              "default": true
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "description": "Items per page.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "example": 5
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number, starting at 1.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "events": {
                      "type": "object",
                      "properties": {
                        "current_page": {
                          "type": "integer"
                        },
                        "data": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer"
                              },
                              "post_id": {
                                "type": "integer"
                              },
                              "calendar_id": {
                                "type": "integer"
                              },
                              "parent_event_id": {
                                "nullable": true
                              },
                              "status": {
                                "type": "string"
                              },
                              "start_at": {
                                "type": "string"
                              },
                              "end_at": {
                                "type": "string"
                              },
                              "timezone": {
                                "type": "string"
                              },
                              "venue_type": {
                                "type": "string"
                              },
                              "meta": {
                                "type": "object",
                                "properties": {
                                  "cover_url": {
                                    "type": "string"
                                  },
                                  "online_meeting_url": {
                                    "type": "string"
                                  },
                                  "venue": {
                                    "type": "string"
                                  },
                                  "address": {
                                    "type": "string"
                                  },
                                  "entry_type": {
                                    "type": "string"
                                  },
                                  "show_guest_count": {
                                    "type": "string"
                                  },
                                  "description_md": {
                                    "type": "string"
                                  }
                                }
                              },
                              "created_at": {
                                "type": "string"
                              },
                              "updated_at": {
                                "type": "string"
                              },
                              "guests_count": {
                                "type": "string"
                              },
                              "title": {
                                "type": "string"
                              },
                              "start_at_local": {
                                "type": "string"
                              },
                              "end_at_local": {
                                "type": "string"
                              },
                              "start_at_site": {
                                "type": "string"
                              },
                              "end_at_site": {
                                "type": "string"
                              },
                              "calendar": {
                                "type": "object",
                                "properties": {
                                  "id": {
                                    "type": "integer"
                                  },
                                  "title": {
                                    "type": "string"
                                  },
                                  "meta": {
                                    "type": "object",
                                    "properties": {
                                      "theme_color": {
                                        "type": "string"
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        },
                        "first_page_url": {
                          "type": "string"
                        },
                        "from": {
                          "type": "integer"
                        },
                        "last_page": {
                          "type": "integer"
                        },
                        "last_page_url": {
                          "type": "string"
                        },
                        "links": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "url": {
                                "nullable": true
                              },
                              "label": {
                                "type": "string"
                              },
                              "active": {
                                "type": "boolean"
                              }
                            }
                          }
                        },
                        "next_page_url": {
                          "nullable": true
                        },
                        "path": {
                          "type": "string"
                        },
                        "per_page": {
                          "type": "integer"
                        },
                        "prev_page_url": {
                          "nullable": true
                        },
                        "to": {
                          "type": "integer"
                        },
                        "total": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "events": {
                    "current_page": 1,
