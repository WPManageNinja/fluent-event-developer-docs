{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentEvent API",
    "description": "REST API for FluentEvent, the WordPress events plugin by WPManageNinja.",
    "version": "1.0.5"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-event/v2",
      "description": "Your WordPress site",
      "variables": {
        "website": {
          "default": "yourwebsite.com",
          "description": "Your WordPress site domain, without https://"
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "http",
        "scheme": "basic",
        "description": "A WordPress username and an Application Password."
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-WP-Nonce",
        "description": "Logged-in cookie plus a `wp_rest` nonce. The browser sends the cookie."
      }
    }
  },
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/calendars/{id}": {
      "get": {
        "operationId": "getCalendar",
        "summary": "Get Calendar",
        "description": "Returns one calendar with its creator's name and its event and guest totals.\n\nController: `CalendarController@getCalendar`\nRoute source: `fluent-event/app/Http/Routes/api.php:39`",
        "tags": [
          "Calendars"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Record ID.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "calendar": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer"
                        },
                        "title": {
                          "type": "string"
                        },
                        "slug": {
                          "type": "string"
                        },
                        "description": {
                          "nullable": true
                        },
                        "visibility": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string"
                        },
                        "meta": {
                          "type": "object",
                          "properties": {
                            "theme_color": {
                              "type": "string"
                            }
                          }
                        },
                        "created_by": {
                          "type": "integer"
                        },
                        "created_at": {
                          "type": "string"
                        },
                        "updated_at": {
                          "type": "string"
                        },
                        "creator_name": {
                          "type": "string"
                        }
                      }
                    },
                    "stats": {
                      "type": "object",
                      "properties": {
                        "total_events": {
                          "type": "object",
                          "properties": {
                            "title": {
                              "type": "string"
                            },
                            "icon": {
                              "type": "string"
                            },
                            "amount": {
                              "type": "integer"
                            },
                            "is_number": {
                              "type": "boolean"
                            }
                          }
                        },
                        "upcoming_events": {
                          "type": "object",
                          "properties": {
                            "title": {
                              "type": "string"
                            },
                            "icon": {
                              "type": "string"
                            },
                            "amount": {
                              "type": "integer"
                            },
                            "is_number": {
                              "type": "boolean"
                            }
                          }
                        },
                        "total_guests": {
                          "type": "object",
                          "properties": {
                            "title": {
                              "type": "string"
                            },
                            "icon": {
                              "type": "string"
                            },
                            "amount": {
                              "type": "integer"
                            },
                            "is_number": {
                              "type": "boolean"
                            }
                          }
                        },
                        "checked_in_guests": {
                          "type": "object",
                          "properties": {
                            "title": {
                              "type": "string"
                            },
                            "icon": {
                              "type": "string"
                            },
                            "amount": {
                              "type": "integer"
                            },
                            "is_number": {
                              "type": "boolean"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "calendar": {
                    "id": 3434,
                    "title": "Team Meetups",
                    "slug": "team-meetups",
                    "description": null,
                    "visibility": "public",
                    "status": "public",
                    "meta": {
                      "theme_color": "#12A9B5"
                    },
                    "created_by": 1,
                    "created_at": "2026-11-17 17:41:46",
                    "updated_at": "2026-11-17 17:41:46",
                    "creator_name": "admin"
                  },
                  "stats": {
                    "total_events": {
                      "title": "Total Events",
                      "icon": "Event",
                      "amount": 2,
                      "is_number": true
                    },
                    "upcoming_events": {
                      "title": "Upcoming Events",
                      "icon": "Upcoming",
                      "amount": 2,
                      "is_number": true
                    },
                    "total_guests": {
                      "title": "Total Guests",
                      "icon": "Guest",
                      "amount": 3,
                      "is_number": true
                    },
                    "checked_in_guests": {
                      "title": "Checked In Guests",
                      "icon": "CheckedIn",
                      "amount": 1,
                      "is_number": true
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "The current user does not have the `manage_options` capability, or the nonce is missing.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No record with that ID.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
