{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentEvent API",
    "description": "REST API for FluentEvent, the WordPress events plugin by WPManageNinja.",
    "version": "1.0.2"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-event/v2",
      "description": "Your WordPress site",
      "variables": {
        "website": {
          "default": "yourwebsite.com",
          "description": "Your WordPress site domain, without https://"
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "http",
        "scheme": "basic",
        "description": "A WordPress username and an Application Password."
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-WP-Nonce",
        "description": "Logged-in cookie plus a `wp_rest` nonce. The browser sends the cookie."
      }
    }
  },
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/calendars": {
      "get": {
        "operationId": "listCalendars",
        "summary": "List Calendars",
        "description": "Returns every calendar with its event and guest counts, plus a count per status for the tabs.\n\nController: `CalendarController@getAllCalendars`\nRoute source: `fluent-event/app/Http/Routes/api.php:38`",
        "tags": [
          "Calendars"
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Matches title or slug.",
            "schema": {
              "type": "string"
            },
            "example": "meetup"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Only calendars with this status.",
            "schema": {
              "type": "string",
              "enum": [
                "public",
                "private",
                "draft"
              ]
            }
          },
          {
            "name": "order_by",
            "in": "query",
            "required": false,
            "description": "Column to sort by.",
            "schema": {
              "enum": [
                "id",
                "title",
                "slug",
                "status",
                "created_at",
                "updated_at"
              ],
              "default": "id",
              "type": "string"
            }
          },
          {
            "name": "order_type",
            "in": "query",
            "required": false,
            "description": "Sort direction.",
            "schema": {
              "enum": [
                "ASC",
                "DESC"
              ],
              "default": "DESC",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "calendars": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer"
                          },
                          "title": {
                            "type": "string"
                          },
                          "slug": {
                            "type": "string"
                          },
                          "description": {
                            "nullable": true
                          },
                          "visibility": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string"
                          },
                          "meta": {
                            "type": "object",
                            "properties": {
                              "theme_color": {
                                "type": "string"
                              }
                            }
                          },
                          "created_by": {
                            "type": "integer"
                          },
                          "created_at": {
                            "type": "string"
                          },
                          "updated_at": {
                            "type": "string"
                          },
                          "events_count": {
                            "type": "string"
                          },
                          "guests_count": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "counts": {
                      "type": "object",
                      "properties": {
                        "all": {
                          "type": "integer"
                        },
                        "public": {
                          "type": "integer"
                        },
                        "draft": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "calendars": [
                    {
                      "id": 744,
                      "title": "Archive",
                      "slug": "archive",
                      "description": null,
                      "visibility": "public",
                      "status": "draft",
                      "meta": {
                        "theme_color": "#0099ff"
                      },
                      "created_by": 1,
                      "created_at": "2026-11-16 11:50:01",
                      "updated_at": "2026-11-16 11:50:01",
                      "events_count": "0",
                      "guests_count": "0"
                    },
                    {
                      "id": 743,
                      "title": "Team Meetups",
                      "slug": "team-meetups",
                      "description": null,
                      "visibility": "public",
                      "status": "public",
                      "meta": {
                        "theme_color": "#12A9B5"
                      },
                      "created_by": 1,
                      "created_at": "2026-11-16 11:50:01",
                      "updated_at": "2026-11-16 11:50:01",
                      "events_count": "2",
                      "guests_count": "3"
                    }
                  ],
                  "counts": {
                    "all": 2,
                    "public": 1,
                    "draft": 1
                  }
                }
              }
            }
          },
          "403": {
            "description": "The current user does not have the `manage_options` capability, or the nonce is missing.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
