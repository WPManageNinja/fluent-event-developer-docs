{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentEvent API",
    "description": "REST API for FluentEvent, the WordPress events plugin by WPManageNinja.",
    "version": "1.0.5"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-event/v2",
      "description": "Your WordPress site",
      "variables": {
        "website": {
          "default": "yourwebsite.com",
          "description": "Your WordPress site domain, without https://"
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "http",
        "scheme": "basic",
        "description": "A WordPress username and an Application Password."
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-WP-Nonce",
        "description": "Logged-in cookie plus a `wp_rest` nonce. The browser sends the cookie."
      }
    }
  },
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/calendars/{id}": {
      "patch": {
        "operationId": "updateCalendar",
        "summary": "Update Calendar",
        "description": "Updates a calendar. Send the full calendar: every required field is validated again.\n\nController: `CalendarController@updateCalendar`\nRoute source: `fluent-event/app/Http/Routes/api.php:42`",
        "tags": [
          "Calendars"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Record ID.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "calendar": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer"
                        },
                        "title": {
                          "type": "string"
                        },
                        "slug": {
                          "type": "string"
                        },
                        "description": {
                          "nullable": true
                        },
                        "visibility": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string"
                        },
                        "meta": {
                          "type": "object",
                          "properties": {
                            "theme_color": {
                              "type": "string"
                            }
                          }
                        },
                        "created_by": {
                          "type": "integer"
                        },
                        "created_at": {
                          "type": "string"
                        },
                        "updated_at": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "message": "Calendar has been successfully updated",
                  "calendar": {
                    "id": 3434,
                    "title": "Team Meetups",
                    "slug": "team-meetups",
                    "description": null,
                    "visibility": "public",
                    "status": "public",
                    "meta": {
                      "theme_color": "#0E8E99"
                    },
                    "created_by": 1,
                    "created_at": "2026-11-17 17:41:46",
                    "updated_at": "2026-11-17 17:41:46"
                  }
                }
              }
            }
          },
          "403": {
            "description": "The current user does not have the `manage_options` capability, or the nonce is missing.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No record with that ID.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation failed. `errors` holds one object per failing field.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "description": "Calendar title. The length limit is filterable."
                  },
                  "slug": {
                    "type": "string",
                    "maxLength": 191,
                    "description": "Unique slug. Generated from the title when empty. Must be unique in `fe_calendars.slug`."
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "public",
                      "private",
                      "draft"
                    ],
                    "description": "Calendar status."
                  },
                  "theme_color": {
                    "type": "string",
                    "nullable": true,
                    "pattern": "^#[A-Fa-f0-9]{6}$",
                    "description": "Six-digit hex colour."
                  }
                },
                "required": [
                  "title",
                  "status"
                ]
              },
              "example": {
                "title": "Team Meetups",
                "slug": "team-meetups",
                "status": "public",
                "theme_color": "#0E8E99"
              }
            }
          }
        }
      }
    }
  }
}
