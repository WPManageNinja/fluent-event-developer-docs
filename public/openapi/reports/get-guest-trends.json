{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentEvent API",
    "description": "REST API for FluentEvent, the WordPress events plugin by WPManageNinja.",
    "version": "1.0.2"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-event/v2",
      "description": "Your WordPress site",
      "variables": {
        "website": {
          "default": "yourwebsite.com",
          "description": "Your WordPress site domain, without https://"
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "http",
        "scheme": "basic",
        "description": "A WordPress username and an Application Password."
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-WP-Nonce",
        "description": "Logged-in cookie plus a `wp_rest` nonce. The browser sends the cookie."
      }
    }
  },
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/reports/guest-trends": {
      "get": {
        "operationId": "getGuestTrends",
        "summary": "Get Guest Trends",
        "description": "Returns new guests per day, or per month for ranges longer than 92 days, ready for a chart.\n\nController: `ReportController@getGuestTrends`\nRoute source: `fluent-event/app/Http/Routes/api.php:49`",
        "tags": [
          "Reports"
        ],
        "parameters": [
          {
            "name": "start_date",
            "in": "query",
            "required": false,
            "description": "First day, `Y-m-d`. Default: 6 days before `end_date`.",
            "schema": {
              "type": "string"
            },
            "example": "2026-11-10"
          },
          {
            "name": "end_date",
            "in": "query",
            "required": false,
            "description": "Last day, `Y-m-d`. Default: today (UTC).",
            "schema": {
              "type": "string"
            },
            "example": "2026-11-16"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "range": {
                      "type": "object",
                      "properties": {
                        "start": {
                          "type": "string"
                        },
                        "end": {
                          "type": "string"
                        }
                      }
                    },
                    "granularity": {
                      "type": "string"
                    },
                    "xAxisData": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "series": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "data": {
                            "type": "array",
                            "items": {
                              "type": "integer"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "range": {
                    "start": "2026-11-10",
                    "end": "2026-11-16"
                  },
                  "granularity": "day",
                  "xAxisData": [
                    "2026-11-10",
                    "2026-11-11",
                    "2026-11-12"
                  ],
                  "series": [
                    {
                      "name": "Total Guests",
                      "data": [
                        0,
                        0,
                        3
                      ]
                    },
                    {
                      "name": "Checked In",
                      "data": [
                        0,
                        0,
                        0
                      ]
                    },
                    {
                      "name": "Cancelled",
                      "data": [
                        0,
                        0,
                        0
                      ]
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "The current user does not have the `manage_options` capability, or the nonce is missing.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
